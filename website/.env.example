# Copy to .env.local and fill in. .env.local is gitignored.

# The backend's origin. In production the website and the API share an origin, so this is only
# needed for local development. It must also appear in the backend's ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8081

# Sign-in. Both are needed for the password grant to be offered at all; without them the sign-in page
# says sign-in is not set up, and links to the dashboard page the key comes from. See README.md.
#
# The key is the `anon` `public` key — publishable, safe to embed, and never the `service_role` one.
# NEXT_PUBLIC_SUPABASE_URL=https://upmarjiewuwvaljnnboq.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The paste-a-token escape hatch, for testing the exchange before an email template or a provider
# exists. **Off unless set to 1**, because a deployed site should not show a credential-paste field
# to whoever opens it. Only meaningful while the pair above is missing.
# NEXT_PUBLIC_ALLOW_TOKEN_SIGN_IN=1

