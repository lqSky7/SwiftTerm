{
  "name": "swiftterm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated relay and share store for SwiftTerm. Owns identity, sessions and metadata; never launches shells.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/http/main.ts",
    "migrate": "node src/db/migrate.ts",
    "provision-roles": "node scripts/provision-roles.ts",
    "test": "node --test --test-force-exit --test-timeout=30000 test/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
