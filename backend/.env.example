# Copy to .env and fill in. .env is gitignored; this file never holds a real secret.

# The API role's connection string. This is the only credential the running service holds, and it
# is deliberately not the owner or the migrator: it has no DDL, no BYPASSRLS and no superuser.
DATABASE_URL=postgresql://swiftterm_api:CHANGE_ME@HOST:5432/postgres

# The migrator's connection string. Used by `npm run migrate` only, never by the server.
MIGRATION_DATABASE_URL=postgresql://swiftterm_migrator:CHANGE_ME@HOST:5432/postgres

# OIDC. Production startup fails without all three; there is no test bypass.
OIDC_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# 32 random bytes, base64. Rotating this invalidates every existing session cookie.
SESSION_SECRET=CHANGE_ME

# Comma-separated exact origins allowed to make authenticated writes and open sockets.
ALLOWED_ORIGINS=http://localhost:5173

# Bind address and port. The process listens on loopback and a tunnel terminates TLS in front.
HOST=127.0.0.1
PORT=8081

# Trust a specific CA bundle (preferred), or skip verification in development only.
# PGSSLROOTCERT=
# DATABASE_SSL_NO_VERIFY=1
